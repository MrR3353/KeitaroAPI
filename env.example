# Copy this file to .env and fill in the values.

# Base URL of your Keitaro tracker, without the /admin_api/v1 suffix.
KEITARO_BASE_URL=https://your-tracker.example.com

# Admin API key, see Keitaro > Settings > API.
KEITARO_API_KEY=changeme

# SQLAlchemy connection string for this app's own database (creation history).
DATABASE_URL=sqlite:///./app.db

# Optional: force a specific Keitaro domain_id for new campaigns.
# If not set, the first active domain returned by GET /domains is used.
KEITARO_DEFAULT_DOMAIN_ID=

# URL the GEO-matched stream redirects to (default: Google).
GOOGLE_REDIRECT_URL=https://www.google.com
